RECALL_HARNESS=codex
# Replace the identity tuple with this person's enrolled device route.
RECALL_CANONICAL_V2_ENABLED=1
RECALL_TENANT_ID=tenant:company:example
RECALL_PRINCIPAL_ID=principal:employee
RECALL_INTERVAL_SECONDS=30
RECALL_PRIVACY_MODE=scrub
RECALL_ROOT=/home/owner/.codex/sessions
RECALL_ARCHIVE_ROOT=/home/owner/.codex/archived_sessions
RECALL_SOURCE_ID=codex:linux:host

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recall.dev/contracts/recall_agent_v1.json",
  "title": "Recall answer-agent boundary v1",
  "description": "Closed request, durable run, content-free trace, and receipt-backed answer contracts.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/run"},
    {"$ref": "#/$defs/trace_event"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}_[A-Za-z0-9_-]{16,128}$"
    },
    "identity": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{1,159}$"
    },
    "receipt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2048,
      "pattern": "^recall://"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "request_id", "idempotency_key", "question", "depth"],
      "properties": {
        "contract": {"const": "recall.agent-request.v1"},
        "schema_version": {"const": 1},
        "request_id": {"$ref": "#/$defs/opaque_id"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "question": {"type": "string", "minLength": 1, "maxLength": 8192},
        "depth": {"enum": ["quick", "normal", "deep"]},
        "since": {"type": "string", "format": "date-time"},
        "until": {"type": "string", "format": "date-time"},
        "source_families": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "run_id", "request_id", "tenant_id", "principal_id", "trace_id", "status", "attempt", "created_at", "updated_at"],
      "properties": {
        "contract": {"const": "recall.agent-run.v1"},
        "schema_version": {"const": 1},
        "run_id": {"$ref": "#/$defs/opaque_id"},
        "request_id": {"$ref": "#/$defs/opaque_id"},
        "tenant_id": {"$ref": "#/$defs/identity"},
        "principal_id": {"$ref": "#/$defs/identity"},
        "trace_id": {"$ref": "#/$defs/opaque_id"},
        "status": {"enum": ["queued", "running", "complete", "partial", "no_answer", "failed"]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}
      }
    },
    "trace_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "trace_id", "run_id", "sequence", "occurred_at", "stage", "outcome", "elapsed_ms", "receipt_count", "source_count", "session_count"],
      "properties": {
        "contract": {"const": "recall.agent-trace-event.v1"},
        "schema_version": {"const": 1},
        "trace_id": {"$ref": "#/$defs/opaque_id"},
        "run_id": {"$ref": "#/$defs/opaque_id"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 10000},
        "occurred_at": {"type": "string", "format": "date-time"},
        "stage": {"enum": ["authorize", "plan", "retrieve", "inspect", "synthesize", "verify", "complete"]},
        "outcome": {"enum": ["started", "ok", "degraded", "denied", "failed"]},
        "elapsed_ms": {"type": "number", "minimum": 0, "maximum": 120000},
        "receipt_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "source_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "session_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "tool": {"$ref": "#/$defs/identity"},
        "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "receipts"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/receipt"}
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schema_version", "run_id", "request_id", "tenant_id", "principal_id", "trace_id", "status", "answer", "claims", "citations", "gaps", "completed_at"],
      "properties": {
        "contract": {"const": "recall.agent-result.v1"},
        "schema_version": {"const": 1},
        "run_id": {"$ref": "#/$defs/opaque_id"},
        "request_id": {"$ref": "#/$defs/opaque_id"},
        "tenant_id": {"$ref": "#/$defs/identity"},
        "principal_id": {"$ref": "#/$defs/identity"},
        "trace_id": {"$ref": "#/$defs/opaque_id"},
        "status": {"enum": ["complete", "partial", "no_answer"]},
        "answer": {"type": "string", "maxLength": 64000},
        "claims": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/claim"}},
        "citations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/receipt"}
        },
        "gaps": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

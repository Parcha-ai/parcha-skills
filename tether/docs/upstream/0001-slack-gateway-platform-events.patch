+    # ------------------------------------------------------------------
+    # gateway_platform_event fire-sites (#64176 — Discord/Telegram parity)
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _platform_events_subscribed() -> bool:
+        """has_hook fast-path shared by every Slack fire-site."""
+        try:
+            from hermes_cli.lifecycle import has_hook
+
+            return has_hook("gateway_platform_event")
+        except Exception:
+            return False
+
+    async def _fire_platform_event(self, event: dict, source) -> None:
+        """Forward one normalized envelope to the gateway-owned boundary.
+
+        No installed callback means no trusted auth boundary — fail closed.
+        Dispatch errors never propagate into the Socket Mode listener.
+        """
+        handler = getattr(self, "_platform_event_handler", None)
+        if handler is None:
+            return
+        try:
+            await handler(event, source)
+        except Exception:
+            logger.debug(
+                "[%s] gateway_platform_event dispatch error", self.name, exc_info=True,
+            )
+
+    def _slack_platform_event_source(
+        self,
+        *,
+        channel_id: str,
+        team_id: Optional[str],
+        user_id: Optional[str],
+        thread_ts: Optional[str],
+        message_id: Optional[str],
+    ):
+        """Build the SessionSource the gateway authorizes against.
+
+        Raises ``ValueError`` when the actor or chat identity is missing so
+        the post-auth boundary fails closed instead of authorizing an
+        incomplete source (mirrors the Discord and Telegram extractors).
+        """
+        if not user_id or not channel_id:
+            raise ValueError(
+                "gateway_platform_event requires actor and chat identities"
+            )
+        return self.build_source(
+            chat_id=str(channel_id),
+            chat_type="thread" if thread_ts else "group",
+            user_id=str(user_id),
+            thread_id=str(thread_ts) if thread_ts else None,
+            scope_id=str(team_id) if team_id else None,
+            parent_chat_id=str(channel_id) if thread_ts else None,
+            message_id=str(message_id) if message_id else None,
+        )
+
+    async def _fire_slack_platform_event(
+        self,
+        event_type: str,
+        *,
+        channel_id: Optional[str],
+        team_id: Optional[str],
+        user_id: Optional[str],
+        thread_ts: Optional[str],
+        message_id: Optional[str],
+        payload_extra: Optional[dict] = None,
+    ) -> None:
+        """Normalize and emit one Slack platform event; never raises."""
+        if not self._platform_events_subscribed():
+            return
+        try:
+            if not channel_id or not message_id:
+                return
+            payload = {
+                "chat_id": str(channel_id)[:128],
+                "message_id": str(message_id)[:128],
+                "thread_id": str(thread_ts)[:128] if thread_ts else None,
+                "workspace_id": str(team_id)[:128] if team_id else None,
+            }
+            if payload_extra:
+                payload.update(payload_extra)
+            event = {
+                "platform": "slack",
+                "event_type": event_type,
+                "payload": payload,
+            }
+            source = self._slack_platform_event_source(
+                channel_id=str(channel_id),
+                team_id=team_id,
+                user_id=user_id,
+                thread_ts=thread_ts,
+                message_id=str(message_id),
+            )
+        except Exception:
+            logger.debug(
+                "[%s] %s normalize error", self.name, event_type, exc_info=True,
+            )
+            return
+        await self._fire_platform_event(event, source)
+
     async def _handle_slack_message(
         self, event: dict, payload: Optional[dict] = None
     ) -> None:

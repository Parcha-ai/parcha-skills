@@ -0,0 +1,311 @@
+"""Slack ``gateway_platform_event`` fire-sites (#64176 Discord/Telegram parity).
+
+Covers the Slack half of the normalized-envelope pipeline:
+* ``message_changed`` / ``message_deleted`` subtypes and reactions normalize
+  to stable plain-dict envelopes (no raw Bolt objects) and dispatch through
+  the gateway-owned post-auth boundary
+* edits fire even when normal dispatch later drops the message as already
+  processed (observers see what routing suppresses)
+* malformed events (missing actor / chat identities) drop, fail closed
+* no installed gateway callback means no fire (no trusted auth boundary)
+* the has_hook no-subscriber fast-path skips all normalization work
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import Platform
+
+_repo = str(Path(__file__).resolve().parents[2])
+if _repo not in sys.path:
+    sys.path.insert(0, _repo)
+
+from plugins.platforms.slack.adapter import SlackAdapter  # noqa: E402
+
+
+def _adapter() -> SlackAdapter:
+    """Build a SlackAdapter without the heavy __init__ (fire-sites only
+    need platform/config, the handler slot, and the tiny state the two
+    message subtype paths read)."""
+    a = object.__new__(SlackAdapter)
+    a.platform = Platform.SLACK
+    a.config = SimpleNamespace(extra={})
+    a.gateway_runner = None
+    a._processed_message_ts = {}
+    a._channel_team = {}
+    a._team_clients = {}
+    a._bot_user_id = "UBOT"
+    return a
+
+
+@pytest.fixture(autouse=True)
+def _observer_available(monkeypatch):
+    monkeypatch.setattr("hermes_cli.lifecycle.has_hook", lambda _name: True)
+
+
+def _capture(a):
+    seen: list = []
+
+    async def observe(event, source):
+        seen.append((event, source))
+
+    a.set_platform_event_handler(observe)
+    return seen
+
+
+def _changed_event(**overrides):
+    message = {
+        "ts": "170.100",
+        "text": "edited body",
+        "user": "U777",
+        "thread_ts": "100.1",
+        "edited": {"ts": "171.000", "user": "U777"},
+    }
+    message.update(overrides.pop("message_overrides", {}))
+    event = {
+        "type": "message",
+        "subtype": "message_changed",
+        "channel": "C555",
+        "team": "T999",
+        "ts": "171.000",
+        "event_ts": "171.000",
+        "message": message,
+    }
+    event.update(overrides)
+    return event
+
+
+class TestMessageEdited:
+    def test_edit_normalized_and_fired_even_when_dispatch_drops_it(self):
+        a = _adapter()
+        seen = _capture(a)
+        # Already processed: normal dispatch drops the edit, the observer
+        # must still see it.
+        a._processed_message_ts["170.100"] = time.time()
+
+        asyncio.run(a._handle_slack_message(_changed_event()))
+
+        assert len(seen) == 1
+        event, source = seen[0]
+        assert event == {
+            "platform": "slack",
+            "event_type": "message_edited",
+            "payload": {
+                "chat_id": "C555",
+                "message_id": "170.100",
+                "thread_id": "100.1",
+                "workspace_id": "T999",
+                "text": "edited body",
+                "edited_ts": "171.000",
+            },
+        }
+        json.dumps(event)
+        assert source.user_id == "U777"
+        assert source.chat_id == "C555"
+        assert source.thread_id == "100.1"
+        assert source.scope_id == "T999"
+
+    def test_edit_without_author_identity_fails_closed(self):
+        a = _adapter()
+        seen = _capture(a)
+        a._processed_message_ts["170.100"] = time.time()
+
+        asyncio.run(a._handle_slack_message(
+            _changed_event(message_overrides={"user": None})
+        ))
+
+        assert seen == []
+
+    def test_malformed_changed_payload_drops(self):
+        a = _adapter()
+        seen = _capture(a)
+
+        asyncio.run(a._handle_slack_message(
+            _changed_event(message="not-a-dict")
+        ))
+
+        assert seen == []
+
+
+class TestMessageDeleted:
+    def _deleted_event(self, **overrides):
+        event = {
+            "type": "message",
+            "subtype": "message_deleted",
+            "channel": "C555",
+            "team": "T999",
+            "ts": "172.000",
+            "deleted_ts": "170.100",
+            "previous_message": {
+                "ts": "170.100",
+                "user": "U777",
+                "thread_ts": "100.1",
+            },
+        }
+        event.update(overrides)
+        return event
+
+    @staticmethod
+    def _prepare(a, monkeypatch):
+        # The deleted subtype crosses dedup, the ignored-channel gate, and
+        # the (marker-based, pure) bot filter before reaching its drop.
+        a._dedup = SimpleNamespace(is_duplicate=lambda _key: False)
+        monkeypatch.setattr(
+            SlackAdapter, "_is_ignored_channel", lambda _self, _cid: False,
+            raising=True,
+        )
+
+    def test_delete_normalized_fired_and_dropped_from_dispatch(self, monkeypatch):
+        a = _adapter()
+        seen = _capture(a)
+        self._prepare(a, monkeypatch)
+        # Guard: reaching normal message dispatch would raise, proving the
+        # deleted subtype still never dispatches.
+        monkeypatch.setattr(
+            SlackAdapter,
+            "handle_message",
+            lambda _self, _event: (_ for _ in ()).throw(AssertionError()),
+            raising=True,
+        )
+
+        asyncio.run(a._handle_slack_message(self._deleted_event()))
+
+        assert len(seen) == 1
+        event, source = seen[0]
+        assert event["event_type"] == "message_deleted"
+        assert event["payload"] == {
+            "chat_id": "C555",
+            "message_id": "170.100",
+            "thread_id": "100.1",
+            "workspace_id": "T999",
+            "author_id": "U777",
+        }
+        json.dumps(event)
+        assert source.user_id == "U777"
+
+    def test_delete_without_author_fails_closed(self, monkeypatch):
+        a = _adapter()
+        seen = _capture(a)
+        self._prepare(a, monkeypatch)
+
+        asyncio.run(a._handle_slack_message(
+            self._deleted_event(previous_message={})
+        ))
+
+        assert seen == []
+
+
+class TestReaction:
+    def _reaction_event(self, **overrides):
+        event = {
+            "type": "reaction_added",
+            "user": "U777",
+            "reaction": "thumbsup",
+            "item": {"type": "message", "channel": "C555", "ts": "170.100"},
+            "event_ts": "173.000",
+        }
+        event.update(overrides)
+        return event
+
+    def _reaction_adapter(self, monkeypatch):
+        a = _adapter()
+        a._channel_team = {"C555": "T999"}
+        monkeypatch.setattr(
+            SlackAdapter,
+            "_slack_reaction_triggers",
+            lambda _self: None,
+            raising=True,
+        )
+        return a
+
+    def test_reaction_normalized_and_fired(self, monkeypatch):
+        a = self._reaction_adapter(monkeypatch)
+        seen = _capture(a)
+
+        asyncio.run(a._handle_slack_reaction(self._reaction_event()))
+
+        assert len(seen) == 1
+        event, source = seen[0]
+        assert event == {
+            "platform": "slack",
+            "event_type": "reaction",
+            "payload": {
+                "chat_id": "C555",
+                "message_id": "170.100",
+                "thread_id": None,
+                "workspace_id": "T999",
+                "reaction": "thumbsup",
+                "action": "added",
+            },
+        }
+        json.dumps(event)
+        assert source.user_id == "U777"
+
+    def test_removed_reaction_carries_action(self, monkeypatch):
+        a = self._reaction_adapter(monkeypatch)
+        seen = _capture(a)
+
+        asyncio.run(
+            a._handle_slack_reaction(self._reaction_event(), removed=True)
+        )
+
+        assert seen[0][0]["payload"]["action"] == "removed"
+
+    def test_self_reaction_never_fires(self, monkeypatch):
+        a = self._reaction_adapter(monkeypatch)
+        seen = _capture(a)
+
+        asyncio.run(
+            a._handle_slack_reaction(self._reaction_event(user="UBOT"))
+        )
+
+        assert seen == []
+
+
+class TestBoundary:
+    def test_no_installed_handler_means_no_fire(self):
+        a = _adapter()  # set_platform_event_handler never called
+        a._processed_message_ts["170.100"] = time.time()
+        asyncio.run(a._handle_slack_message(_changed_event()))
+        # Nothing to assert beyond "no crash": with no handler there is no
+        # trusted auth boundary and the fire-site must be inert.
+
+    def test_no_subscriber_fast_path_skips_normalization(self, monkeypatch):
+        monkeypatch.setattr(
+            "hermes_cli.lifecycle.has_hook", lambda _name: False
+        )
+        a = _adapter()
+        seen = _capture(a)
+        a._processed_message_ts["170.100"] = time.time()
+
+        def _boom(**_kwargs):
+            raise AssertionError("normalization ran without a subscriber")
+
+        monkeypatch.setattr(
+            SlackAdapter,
+            "_slack_platform_event_source",
+            _boom,
+            raising=True,
+        )
+
+        asyncio.run(a._handle_slack_message(_changed_event()))
+
+        assert seen == []
+
+    def test_raising_observer_never_breaks_the_listener(self):
+        a = _adapter()
+        a._processed_message_ts["170.100"] = time.time()
+
+        async def boom(_event, _source):
+            raise RuntimeError("observer bug")
+
+        a.set_platform_event_handler(boom)
+        asyncio.run(a._handle_slack_message(_changed_event()))

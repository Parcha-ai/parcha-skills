diff --git a/agent/claude_code_runtime.py b/agent/claude_code_runtime.py
new file mode 100644
index 000000000..ac99c46d7
--- /dev/null
+++ b/agent/claude_code_runtime.py
@@ -0,0 +1,218 @@
+"""Claude Code runtime — hand a whole turn to a ``claude -p`` stream-json subprocess.
+
+Opt-in via ``model.anthropic_runtime: claude_code`` (api_mode ``claude_code``).
+Claude Code owns the tool loop, permissions, hooks, MCP servers, skills and context
+compaction; Hermes is the shell around it: sessions DB, gateway platforms, slash
+commands, memory. The shape mirrors ``agent/codex_runtime.py`` for the Codex CLI, and
+the shared helpers are imported from there.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Callable, Dict, List
+
+from agent.codex_runtime import (
+    _call_guarded, _coerce_usage_int, _consume_user_interrupt, _persist_projected_messages, _queue_token_counts,
+    _turn_result,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def claude_code_settings(agent) -> Dict[str, Any]:
+    """``model.claude_code`` block from the loaded config (all keys optional)."""
+    cfg = getattr(agent, "_user_config", None) or {}
+    if not isinstance(cfg, dict):
+        try:
+            from hermes_cli.config import load_config_readonly
+            cfg = load_config_readonly() or {}
+        except Exception:
+            cfg = {}
+    model_cfg = cfg.get("model") if isinstance(cfg.get("model"), dict) else {}
+    block = model_cfg.get("claude_code") if isinstance(model_cfg.get("claude_code"), dict) else {}
+    return dict(block)
+
+
+def _ensure_claude_session(agent) -> None:
+    """Lazily spawn one ClaudeCodeSession per AIAgent (reused across turns, closed by the _cleanup hook)."""
+    if getattr(agent, "_claude_session", None) is not None:
+        return
+    from agent.runtime_cwd import resolve_agent_cwd
+    from agent.transports.claude_code_session import ClaudeCodeSession, session_id_for
+    settings = claude_code_settings(agent)
+    permission_mode = settings.get("permission_mode")
+    try:
+        from tools.approval import is_approval_bypass_active
+        if is_approval_bypass_active():
+            permission_mode = "bypassPermissions"
+    except Exception:
+        logger.debug("claude code: approval-bypass lookup failed; keeping configured permission mode", exc_info=True)
+    hermes_session_id = str(getattr(agent, "session_id", None) or "")
+    agent._claude_session = ClaudeCodeSession(
+        session_id=session_id_for(hermes_session_id) if hermes_session_id else session_id_for(str(id(agent))),
+        cwd=getattr(agent, "session_cwd", None) or str(resolve_agent_cwd()),
+        claude_bin=str(settings.get("binary") or "claude"),
+        model=settings.get("model") or (agent.model if _looks_like_claude_alias(getattr(agent, "model", "")) else None),
+        permission_mode=permission_mode,
+        allowed_tools=settings.get("allowed_tools") if isinstance(settings.get("allowed_tools"), list) else None,
+        extra_args=settings.get("extra_args") if isinstance(settings.get("extra_args"), list) else None,
+        env_passthrough=tuple(str(k) for k in settings.get("env_passthrough") or [] if isinstance(k, str)),
+        turn_timeout=float(settings.get("turn_timeout_seconds") or 1800),
+        on_event=make_claude_code_event_bridge(agent),
+    )
+
+
+def _looks_like_claude_alias(model: Any) -> bool:
+    """Only pass ``--model`` when the configured model is something the CLI accepts."""
+    name = str(model or "").lower()
+    return name in {"sonnet", "opus", "haiku"} or name.startswith("claude-")
+
+
+def _close_claude_session(agent) -> None:
+    session = getattr(agent, "_claude_session", None)
+    if session is not None:
+        try:
+            session.close()
+        except Exception:
+            logger.debug("claude code session close failed", exc_info=True)
+    agent._claude_session = None
+
+
+def make_claude_code_event_bridge(agent) -> Callable[[dict], None]:
+    """Project Claude Code stream-json events into Hermes' gateway UI callbacks.
+
+    ``assistant`` tool_use blocks fire ``tool_progress_callback`` / ``tool_start_callback``;
+    the matching ``user`` tool_result blocks fire the completed pair; text blocks that
+    precede tool calls go to ``_emit_interim_assistant_message`` (mid-turn commentary,
+    gated by ``display.show_commentary``).
+    """
+    started: Dict[str, tuple[str, Any, float]] = {}
+
+    def agent_cb(attr: str, fail_msg: str, *fail_args: Any, args: tuple = (), kwargs: dict | None = None) -> None:
+        _call_guarded(getattr(agent, attr, None), fail_msg, *fail_args, args=args, kwargs=kwargs)
+
+    def on_event(event: dict) -> None:
+        kind = event.get("type")
+        message = event.get("message") or {}
+        content = message.get("content")
+        blocks = content if isinstance(content, list) else []
+        if kind == "assistant":
+            has_tools = any(isinstance(b, dict) and b.get("type") == "tool_use" for b in blocks)
+            for block in blocks:
+                if not isinstance(block, dict):
+                    continue
+                if block.get("type") == "text" and has_tools and str(block.get("text") or "").strip():
+                    if getattr(agent, "show_commentary", True):
+                        agent_cb("_emit_interim_assistant_message", "_emit_interim_assistant_message raised",
+                                 args=({"role": "assistant", "content": str(block["text"])},))
+                elif block.get("type") == "tool_use":
+                    call_id = str(block.get("id") or "")
+                    name = str(block.get("name") or "tool")
+                    args = block.get("input")
+                    started[call_id] = (name, args, time.monotonic())
+                    agent_cb("tool_progress_callback", "tool_progress_callback raised on tool.started for %s", name,
+                             args=("tool.started", name, _preview(name, args), args))
+                    agent_cb("tool_start_callback", "tool_start_callback raised for %s", name,
+                             args=(call_id, name, args))
+        elif kind == "user":
+            for block in blocks:
+                if not isinstance(block, dict) or block.get("type") != "tool_result":
+                    continue
+                call_id = str(block.get("tool_use_id") or "")
+                name, args, t0 = started.pop(call_id, ("tool", None, None))
+                duration = (time.monotonic() - t0) if t0 else None
+                is_error = bool(block.get("is_error"))
+                result = block.get("content")
+                agent_cb("tool_progress_callback", "tool_progress_callback raised on tool.completed for %s", name,
+                         args=("tool.completed", name, None, None),
+                         kwargs={"duration": duration, "is_error": is_error, "result": result})
+                agent_cb("tool_complete_callback", "tool_complete_callback raised for %s", name,
+                         args=(call_id, name, args, result))
+
+    return on_event
+
+
+def _preview(name: str, args: Any) -> str:
+    if isinstance(args, dict):
+        for key in ("command", "file_path", "pattern", "query", "path", "url", "prompt"):
+            if args.get(key):
+                return str(args[key])[:200]
+    return name
+
+
+def _record_claude_code_usage(agent, turn, messages=None) -> dict[str, Any]:
+    """Translate the ``result`` usage block into Hermes accounting; a turn with no usage still counts."""
+    agent.session_api_calls += 1
+    usage = getattr(turn, "usage", None)
+
+    def billing(**extra):
+        return dict(model=agent.model, billing_provider=agent.provider, billing_base_url=agent.base_url,
+                    api_call_count=1, **extra)
+
+    if not isinstance(usage, dict) or not usage:
+        _queue_token_counts(agent, "Claude Code api-call persistence failed (session=%s): %s",
+                            counts=lambda: billing(billing_mode="subscription_included"))
+        return {}
+    from agent.usage_pricing import CanonicalUsage, estimate_usage_cost
+    canonical = CanonicalUsage(
+        input_tokens=_coerce_usage_int(usage.get("input_tokens")),
+        output_tokens=_coerce_usage_int(usage.get("output_tokens")),
+        cache_read_tokens=_coerce_usage_int(usage.get("cache_read_input_tokens")),
+        cache_write_tokens=_coerce_usage_int(usage.get("cache_creation_input_tokens")),
+        reasoning_tokens=0, raw_usage=usage,
+    )
+    token_counts = {f: getattr(canonical, f) for f in
+                    ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens")}
+    usage_dict = {"prompt_tokens": canonical.prompt_tokens, "completion_tokens": canonical.output_tokens,
+                  "total_tokens": canonical.total_tokens, **token_counts}
+    for key, value in usage_dict.items():
+        setattr(agent, f"session_{key}", getattr(agent, f"session_{key}", 0) + value)
+    reported = getattr(turn, "total_cost_usd", None)
+    if isinstance(reported, (int, float)):
+        cost_usd, status, source = float(reported), "estimated", "claude_code"
+    else:
+        cost_result = estimate_usage_cost(agent.model, canonical, provider=agent.provider, base_url=agent.base_url,
+                                          api_key=getattr(agent, "api_key", ""))
+        cost_usd = float(cost_result.amount_usd) if cost_result.amount_usd is not None else None
+        status, source = cost_result.status, cost_result.source
+    if cost_usd is not None:
+        agent.session_estimated_cost_usd += cost_usd
+    agent.session_cost_status, agent.session_cost_source = status, source
+    cost_fields = {"estimated_cost_usd": cost_usd, "cost_status": status, "cost_source": source}
+    _queue_token_counts(agent, "Claude Code token persistence failed (session=%s, tokens=%d): %s",
+                        canonical.total_tokens, counts=lambda: billing(**token_counts, **cost_fields))
+    return {**usage_dict, "last_prompt_tokens": canonical.prompt_tokens, **cost_fields}
+
+
+def run_claude_code_turn(agent, *, user_message: str, original_user_message: Any, messages: List[Dict[str, Any]],
+                         effective_task_id: str, should_review_memory: bool = False) -> Dict[str, Any]:
+    """Hand the turn to Claude Code and project its transcript into ``messages``.
+
+    Returns the chat_completions result shape. The user message is ALREADY in ``messages``."""
+    _ensure_claude_session(agent)
+    turn = agent._claude_session.run_turn(user_input=user_message)
+    interrupt = _consume_user_interrupt(agent, turn.interrupted)
+    if getattr(turn, "should_retire", False):
+        logger.warning("claude code session retired (turn error: %s)", turn.error)
+        _close_claude_session(agent)
+    _persist_projected_messages(agent, turn, messages)
+    agent._iters_since_skill = getattr(agent, "_iters_since_skill", 0) + turn.tool_iterations
+    usage_result = _record_claude_code_usage(agent, turn, messages=messages)
+    if not turn.interrupted and turn.error is None:
+        _call_guarded(getattr(agent, "_sync_external_memory_for_turn", None), "external memory sync raised", kwargs=dict(
+            original_user_message=original_user_message, final_response=turn.final_text, interrupted=False,
+            messages=messages,
+        ))
+    if turn.final_text and not turn.interrupted and should_review_memory:
+        _call_guarded(getattr(agent, "_spawn_background_review", None), "background review spawn raised", kwargs=dict(
+            messages_snapshot=list(messages), review_memory=True, review_skills=False,
+        ))
+    final = turn.final_text
+    if turn.error and not final:
+        final = f"Claude Code turn failed: {turn.error}"
+    return _turn_result(
+        interrupt, messages, api_calls=1, completed=not turn.interrupted and turn.error is None, error=turn.error,
+        final_response=final, agent_persisted=True, claude_session_id=turn.session_id, **usage_result,
+    )

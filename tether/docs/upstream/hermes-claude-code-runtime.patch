diff --git a/agent/transports/claude_code_session.py b/agent/transports/claude_code_session.py
new file mode 100644
index 000000000..12c0448a3
--- /dev/null
+++ b/agent/transports/claude_code_session.py
@@ -0,0 +1,375 @@
+"""One long-lived ``claude -p`` process per Hermes session, spoken to over stream-json.
+
+Claude Code owns the tool loop (its terminal, file edits, permissions, hooks, MCP
+servers, skills and context compaction); Hermes is the shell around it: sessions
+DB, gateway, slash commands, memory. Mirrors ``codex_app_server_session`` for the
+Codex CLI.
+
+Wire protocol (``--input-format stream-json --output-format stream-json --verbose``):
+we write one ``{"type": "user", "message": {...}}`` line per turn; Claude Code
+streams ``system`` (init), ``assistant`` (content blocks: text / tool_use),
+``user`` (tool_result blocks it produced itself), and one ``result`` line that
+ends the turn. ``control_request`` / ``control_response`` frames carry interrupts.
+
+The session id is chosen by Hermes (``--session-id`` on first start, ``--resume``
+afterwards) so a gateway session survives Hermes restarts and reattaches to the
+same Claude Code transcript on disk.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import queue
+import shutil
+import subprocess
+import threading
+import time
+import uuid
+from dataclasses import dataclass, field
+from typing import Any, Callable, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+_STDERR_TAIL_LINES = 8
+
+# Environment a Claude Code child needs from a login shell. Provider keys and base
+# URLs the *Hermes* process uses are deliberately not inherited: the CLI carries its
+# own auth (claude.ai login or ANTHROPIC_* passed through explicitly via config).
+SAFE_CHILD_ENV = frozenset({
+    "HOME", "USER", "LOGNAME", "PATH", "SHELL", "LANG", "LC_ALL", "LC_CTYPE", "TERM", "TMPDIR",
+    "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR",
+    "CLAUDE_HOME", "CLAUDE_CONFIG_DIR", "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS",
+    "DBUS_SESSION_BUS_ADDRESS", "SSH_AUTH_SOCK",
+})
+
+# Hermes terminal security mode -> Claude Code permission mode. ``bypassPermissions``
+# only when the operator asked for an approval bypass (approvals.mode: off, --yolo).
+_HERMES_TO_CLAUDE_PERMISSION_MODE = {
+    "auto": "acceptEdits",
+    "off": "bypassPermissions",
+    "hermes": "acceptEdits",
+    "workspace": "acceptEdits",
+    "docker": "acceptEdits",
+    "strict": "default",
+}
+
+
+class ClaudeCodeError(RuntimeError):
+    pass
+
+
+@dataclass
+class TurnResult:
+    """Result of one user -> assistant -> tools turn through Claude Code."""
+
+    final_text: str = ""
+    projected_messages: list[dict] = field(default_factory=list)
+    tool_iterations: int = 0
+    interrupted: bool = False
+    error: Optional[str] = None
+    session_id: Optional[str] = None
+    submitted_user_text: Optional[str] = None
+    usage: Optional[dict[str, Any]] = None
+    duration_ms: Optional[int] = None
+    num_turns: Optional[int] = None
+    total_cost_usd: Optional[float] = None
+    # Process died or the deadline blew: the caller respawns next turn.
+    should_retire: bool = False
+
+
+def child_env(source: Optional[Dict[str, str]] = None, passthrough: tuple[str, ...] = ()) -> Dict[str, str]:
+    """Login-shell env plus an explicit passthrough list (e.g. ANTHROPIC_API_KEY for a machine proxy)."""
+    base = os.environ if source is None else source
+    env = {key: value for key, value in base.items() if key in SAFE_CHILD_ENV}
+    for key in passthrough:
+        if key in base:
+            value = base[key]
+            if key.endswith("_BASE_URL"):
+                # The CLI appends /v1 itself; a proxy URL carrying it makes every model "missing".
+                value = value.rstrip("/")
+                if value.endswith("/v1"):
+                    value = value[:-3]
+            env[key] = value
+    return env
+
+
+def session_id_for(hermes_session_id: str) -> str:
+    """Deterministic Claude Code session id for a Hermes session, so resume needs no extra state."""
+    return str(uuid.uuid5(uuid.NAMESPACE_URL, f"hermes-agent:claude-code:{hermes_session_id}"))
+
+
+def transcript_exists(session_id: str, cwd: str) -> bool:
+    """Claude Code keeps ``~/.claude/projects/<encoded cwd>/<session id>.jsonl``."""
+    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
+    encoded = os.path.abspath(cwd).replace("/", "-")
+    return os.path.isfile(os.path.join(home, "projects", encoded, f"{session_id}.jsonl"))
+
+
+class ClaudeCodeSession:
+    """One Claude Code session per Hermes session, lifetime owned by AIAgent. One caller at a time."""
+
+    def __init__(
+        self, *, session_id: str, cwd: Optional[str] = None, claude_bin: str = "claude",
+        model: Optional[str] = None, permission_mode: Optional[str] = None,
+        allowed_tools: Optional[List[str]] = None, extra_args: Optional[List[str]] = None,
+        env_passthrough: tuple[str, ...] = (), turn_timeout: float = 1800.0,
+        on_event: Optional[Callable[[dict], None]] = None,
+        popen: Callable[..., subprocess.Popen] = subprocess.Popen,
+    ) -> None:
+        self.session_id = session_id
+        self._cwd = cwd or os.getcwd()
+        self._claude_bin = claude_bin
+        self._model = model
+        self._permission_mode = permission_mode or _HERMES_TO_CLAUDE_PERMISSION_MODE.get(
+            os.environ.get("HERMES_TERMINAL_SECURITY_MODE", "auto"), "acceptEdits"
+        )
+        self._allowed_tools = list(allowed_tools or [])
+        self._extra_args = list(extra_args or [])
+        self._env_passthrough = tuple(env_passthrough)
+        self._turn_timeout = turn_timeout
+        self._on_event = on_event
+        self._popen = popen
+        self._process: Optional[subprocess.Popen] = None
+        self._events: "queue.Queue[Optional[dict]]" = queue.Queue()
+        self._reader: Optional[threading.Thread] = None
+        self._stderr: List[str] = []
+        self._interrupt_event = threading.Event()
+        self._closed = False
+        self._resumed = False
+
+    # -- process -----------------------------------------------------------------
+
+    def argv(self) -> List[str]:
+        binary = shutil.which(self._claude_bin) or self._claude_bin
+        args = [binary, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose"]
+        if transcript_exists(self.session_id, self._cwd):
+            args += ["--resume", self.session_id]
+            self._resumed = True
+        else:
+            args += ["--session-id", self.session_id]
+        if self._model:
+            args += ["--model", self._model]
+        if self._permission_mode == "bypassPermissions":
+            args += ["--dangerously-skip-permissions"]
+        elif self._permission_mode:
+            args += ["--permission-mode", self._permission_mode]
+        if self._allowed_tools:
+            args += ["--allowedTools", ",".join(self._allowed_tools)]
+        args += self._extra_args
+        return args
+
+    def ensure_started(self) -> str:
+        """Spawn the child if needed; idempotent; returns the Claude Code session id."""
+        if self._closed:
+            raise ClaudeCodeError("session is closed")
+        if self._process is not None and self._process.poll() is None:
+            return self.session_id
+        argv = self.argv()
+        self._process = self._popen(  # nosec B603 - fixed argv, no shell
+            argv, cwd=self._cwd, env=child_env(passthrough=self._env_passthrough),
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, bufsize=1, start_new_session=True,
+        )
+        self._events = queue.Queue()
+        self._stderr = []
+        self._reader = threading.Thread(target=self._pump, name="claude-code-stdout", daemon=True)
+        self._reader.start()
+        threading.Thread(target=self._pump_stderr, name="claude-code-stderr", daemon=True).start()
+        logger.info("claude code session %s: %s (cwd=%s, permission=%s)", self.session_id[:8],
+                    "resumed" if self._resumed else "started", self._cwd, self._permission_mode)
+        return self.session_id
+
+    def _pump(self) -> None:
+        stdout = self._process.stdout if self._process else None
+        try:
+            for line in stdout or []:
+                try:
+                    event = json.loads(line)
+                except ValueError:
+                    continue
+                if isinstance(event, dict):
+                    self._events.put(event)
+        except (OSError, ValueError):
+            pass
+        finally:
+            self._events.put(None)
+
+    def _pump_stderr(self) -> None:
+        stderr = self._process.stderr if self._process else None
+        try:
+            for line in stderr or []:
+                self._stderr.append(line.rstrip("\n"))
+                del self._stderr[:-200]
+        except (OSError, ValueError):
+            pass
+
+    def alive(self) -> bool:
+        return self._process is not None and self._process.poll() is None
+
+    def close(self) -> None:
+        self._closed = True
+        process, self._process = self._process, None
+        if process is None:
+            return
+        try:
+            if process.stdin is not None:
+                process.stdin.close()
+        except OSError:
+            pass
+        try:
+            process.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            process.terminate()
+            try:
+                process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                process.kill()
+
+    def request_interrupt(self) -> None:
+        """Ask Claude Code to stop the running turn (stream-json control frame)."""
+        self._interrupt_event.set()
+        self._write({"type": "control_request", "request_id": uuid.uuid4().hex,
+                     "request": {"subtype": "interrupt"}})
+
+    def request_steer(self, text: str) -> bool:
+        """Claude Code has no steer frame; the caller queues the message for the next turn."""
+        return False
+
+    def stderr_tail(self, n: int = _STDERR_TAIL_LINES) -> str:
+        return "\n".join(line for line in self._stderr[-n:] if line.strip())
+
+    # -- turns ---------------------------------------------------------------------
+
+    def _write(self, frame: dict) -> None:
+        process = self._process
+        if process is None or process.stdin is None:
+            raise ClaudeCodeError("claude code process has no stdin")
+        try:
+            process.stdin.write(json.dumps(frame) + "\n")
+            process.stdin.flush()
+        except (OSError, ValueError) as exc:
+            raise ClaudeCodeError(f"write to claude code failed: {exc}") from exc
+
+    def run_turn(self, *, user_input: Any, timeout: Optional[float] = None) -> TurnResult:
+        text = _coerce_user_text(user_input)
+        result = TurnResult(session_id=self.session_id, submitted_user_text=text)
+        try:
+            self.ensure_started()
+            self._interrupt_event.clear()
+            self._write({"type": "user", "message": {"role": "user", "content": [{"type": "text", "text": text}]}})
+        except (ClaudeCodeError, OSError) as exc:
+            result.error = f"claude code start failed: {exc}" + (f"\n{self.stderr_tail()}" if self.stderr_tail() else "")
+            result.should_retire = True
+            return result
+        deadline = time.monotonic() + (timeout or self._turn_timeout)
+        started: Dict[str, tuple[str, Any, float]] = {}
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                result.error = f"claude code turn exceeded {int(timeout or self._turn_timeout)}s"
+                result.should_retire = True
+                self.request_interrupt()
+                return result
+            try:
+                event = self._events.get(timeout=min(remaining, 1.0))
+            except queue.Empty:
+                continue
+            if event is None:
+                tail = self.stderr_tail()
+                result.error = "claude code exited during the turn" + (f": {tail}" if tail else "")
+                result.should_retire = True
+                return result
+            self._absorb(event, result, started)
+            if event.get("type") == "result":
+                return result
+
+    def _absorb(self, event: dict, result: TurnResult, started: Dict[str, tuple[str, Any, float]]) -> None:
+        kind = event.get("type")
+        if self._on_event is not None:
+            try:
+                self._on_event(event)
+            except Exception:
+                logger.debug("claude code on_event raised", exc_info=True)
+        if kind == "assistant":
+            message = event.get("message") or {}
+            content = message.get("content")
+            text_parts: List[str] = []
+            tool_calls: List[dict] = []
+            for block in content if isinstance(content, list) else []:
+                if not isinstance(block, dict):
+                    continue
+                if block.get("type") == "text" and block.get("text"):
+                    text_parts.append(str(block["text"]))
+                elif block.get("type") == "tool_use":
+                    call_id = str(block.get("id") or uuid.uuid4().hex)
+                    name = str(block.get("name") or "tool")
+                    args = block.get("input")
+                    started[call_id] = (name, args, time.monotonic())
+                    tool_calls.append({"id": call_id, "type": "function", "function": {
+                        "name": name, "arguments": json.dumps(args if args is not None else {}),
+                    }})
+            if isinstance(content, str) and content:
+                text_parts.append(content)
+            if text_parts or tool_calls:
+                projected: dict = {"role": "assistant", "content": "\n".join(text_parts)}
+                if tool_calls:
+                    projected["tool_calls"] = tool_calls
+                    result.tool_iterations += 1
+                result.projected_messages.append(projected)
+        elif kind == "user":
+            message = event.get("message") or {}
+            content = message.get("content")
+            for block in content if isinstance(content, list) else []:
+                if not isinstance(block, dict) or block.get("type") != "tool_result":
+                    continue
+                call_id = str(block.get("tool_use_id") or "")
+                name = started.pop(call_id, ("tool", None, 0.0))[0] if call_id in started else "tool"
+                result.projected_messages.append({
+                    "role": "tool", "tool_call_id": call_id, "tool_name": name,
+                    "content": _tool_result_text(block.get("content")),
+                })
+        elif kind == "result":
+            result.final_text = str(event.get("result") or "")
+            result.session_id = str(event.get("session_id") or self.session_id)
+            result.usage = event.get("usage") if isinstance(event.get("usage"), dict) else None
+            result.duration_ms = event.get("duration_ms")
+            result.num_turns = event.get("num_turns")
+            result.total_cost_usd = event.get("total_cost_usd")
+            if event.get("is_error"):
+                result.error = result.final_text or str(event.get("subtype") or "claude code error")
+            if self._interrupt_event.is_set():
+                result.interrupted = True
+            if not result.final_text and result.projected_messages:
+                last = result.projected_messages[-1]
+                if last.get("role") == "assistant" and not last.get("tool_calls"):
+                    result.final_text = str(last.get("content") or "")
+
+
+def _coerce_user_text(user_input: Any) -> str:
+    if isinstance(user_input, str):
+        return user_input
+    if isinstance(user_input, list):
+        parts = []
+        for item in user_input:
+            if isinstance(item, dict) and item.get("type") == "text":
+                parts.append(str(item.get("text") or ""))
+            elif isinstance(item, str):
+                parts.append(item)
+        return "\n".join(parts)
+    return str(user_input)
+
+
+def _tool_result_text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = []
+        for block in content:
+            if isinstance(block, dict) and block.get("type") == "text":
+                parts.append(str(block.get("text") or ""))
+            elif isinstance(block, dict) and block.get("type") == "image":
+                parts.append("[image]")
+        return "\n".join(parts)
+    return "" if content is None else json.dumps(content)

@@ -0,0 +1,203 @@
+"""Claude Code runtime: the stream-json transport against a fake ``claude`` and the turn projection."""
+
+from __future__ import annotations
+
+import json
+import os
+import stat
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent.claude_code_runtime import (
+    _record_claude_code_usage, make_claude_code_event_bridge, run_claude_code_turn,
+)
+from agent.transports.claude_code_session import (
+    ClaudeCodeSession, child_env, session_id_for, transcript_exists,
+)
+
+FAKE_CLAUDE = r'''#!/usr/bin/env python3
+import json, os, sys
+argv = sys.argv[1:]
+sid = argv[argv.index("--session-id") + 1] if "--session-id" in argv else argv[argv.index("--resume") + 1]
+log = os.environ.get("FAKE_CLAUDE_LOG")
+if log:
+    open(log, "a").write(json.dumps(argv) + "\n")
+print(json.dumps({"type": "system", "subtype": "init", "session_id": sid, "cwd": os.getcwd()})); sys.stdout.flush()
+for line in sys.stdin:
+    frame = json.loads(line)
+    if frame.get("type") == "control_request":
+        continue
+    text = frame["message"]["content"][0]["text"]
+    if "CRASH" in text:
+        sys.stderr.write("session limit reached\n"); sys.exit(1)
+    if "TOOL" in text:
+        print(json.dumps({"type": "assistant", "message": {"role": "assistant", "content": [
+            {"type": "text", "text": "Let me look."},
+            {"type": "tool_use", "id": "toolu_1", "name": "Bash", "input": {"command": "ls"}}]}}))
+        print(json.dumps({"type": "user", "message": {"role": "user", "content": [
+            {"type": "tool_result", "tool_use_id": "toolu_1", "content": [{"type": "text", "text": "a.py"}]}]}}))
+    final = "ERR" if "ERR" in text else f"echo: {text}"
+    print(json.dumps({"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": final}]}}))
+    print(json.dumps({"type": "result", "subtype": "error_during_execution" if "ERR" in text else "success",
+                      "is_error": "ERR" in text, "result": final, "session_id": sid, "duration_ms": 12, "num_turns": 1,
+                      "total_cost_usd": 0.01, "usage": {"input_tokens": 10, "output_tokens": 5,
+                                                         "cache_read_input_tokens": 3, "cache_creation_input_tokens": 0}}))
+    sys.stdout.flush()
+'''
+
+
+@pytest.fixture
+def fake_claude(tmp_path: Path, monkeypatch):
+    script = tmp_path / "claude"
+    script.write_text(FAKE_CLAUDE)
+    script.chmod(script.stat().st_mode | stat.S_IXUSR)
+    log = tmp_path / "argv.log"
+    monkeypatch.setenv("FAKE_CLAUDE_LOG", str(log))
+    monkeypatch.setenv("CLAUDE_CONFIG_DIR", str(tmp_path / "claude-home"))
+    return script, log
+
+
+def _session(fake_claude, tmp_path, **kw):
+    script, _ = fake_claude
+    return ClaudeCodeSession(session_id=session_id_for("hermes-1"), cwd=str(tmp_path), claude_bin=str(script),
+                             env_passthrough=("FAKE_CLAUDE_LOG", "CLAUDE_CONFIG_DIR"), **kw)
+
+
+def test_session_id_is_deterministic_and_env_is_allowlisted(monkeypatch):
+    assert session_id_for("abc") == session_id_for("abc")
+    assert session_id_for("abc") != session_id_for("abd")
+    env = child_env({"HOME": "/h", "ANTHROPIC_BASE_URL": "https://proxy/v1/", "OPENAI_API_KEY": "x", "PATH": "/bin"},
+                    passthrough=("ANTHROPIC_BASE_URL",))
+    assert env == {"HOME": "/h", "PATH": "/bin", "ANTHROPIC_BASE_URL": "https://proxy"}
+
+
+def test_turns_share_one_process_and_project_tools(fake_claude, tmp_path):
+    session = _session(fake_claude, tmp_path)
+    first = session.run_turn(user_input="hello")
+    assert first.error is None and first.final_text == "echo: hello"
+    assert first.usage["input_tokens"] == 10 and first.total_cost_usd == 0.01
+    second = session.run_turn(user_input="TOOL please")
+    assert second.tool_iterations == 1
+    roles = [m["role"] for m in second.projected_messages]
+    assert roles == ["assistant", "tool", "assistant"]
+    assert second.projected_messages[0]["tool_calls"][0]["function"]["name"] == "Bash"
+    assert second.projected_messages[1] == {"role": "tool", "tool_call_id": "toolu_1", "tool_name": "Bash", "content": "a.py"}
+    assert second.final_text == "echo: TOOL please"
+    argv_lines = (fake_claude[1]).read_text().splitlines()
+    assert len(argv_lines) == 1, "one process for two turns"
+    assert "--session-id" in argv_lines[0] and "--permission-mode" in argv_lines[0]
+    session.close()
+
+
+def test_resume_when_a_transcript_exists(fake_claude, tmp_path, monkeypatch):
+    sid = session_id_for("hermes-1")
+    home = Path(os.environ["CLAUDE_CONFIG_DIR"]) / "projects" / str(tmp_path.resolve()).replace("/", "-")
+    home.mkdir(parents=True)
+    (home / f"{sid}.jsonl").write_text("{}\n")
+    assert transcript_exists(sid, str(tmp_path))
+    session = _session(fake_claude, tmp_path)
+    assert "--resume" in session.argv() and "--session-id" not in session.argv()
+    session.close()
+
+
+def test_error_result_and_crash_are_reported(fake_claude, tmp_path):
+    session = _session(fake_claude, tmp_path)
+    bad = session.run_turn(user_input="ERR now")
+    assert bad.error == "ERR" and bad.should_retire is False
+    crashed = session.run_turn(user_input="CRASH")
+    assert crashed.should_retire is True
+    assert "exited during the turn" in crashed.error and "session limit" in crashed.error
+    # a fresh process serves the next turn
+    again = session.run_turn(user_input="back")
+    assert again.final_text == "echo: back"
+    assert len(fake_claude[1].read_text().splitlines()) == 2
+    session.close()
+
+
+def test_bypass_permissions_flag(fake_claude, tmp_path):
+    session = _session(fake_claude, tmp_path, permission_mode="bypassPermissions", allowed_tools=["Bash", "Read"])
+    argv = session.argv()
+    assert "--dangerously-skip-permissions" in argv and "--allowedTools" in argv and "Bash,Read" in argv
+
+
+def _agent(turn):
+    agent = MagicMock()
+    agent._claude_session = MagicMock()
+    agent._claude_session.run_turn.return_value = turn
+    agent._iters_since_skill = 0
+    agent._session_db = None
+    agent.session_id = "hermes-1"
+    agent.model = "claude-opus-5"
+    agent.provider = "anthropic"
+    agent.base_url = "https://api.anthropic.com"
+    for name in ("session_api_calls", "session_prompt_tokens", "session_completion_tokens", "session_total_tokens",
+                 "session_input_tokens", "session_output_tokens", "session_cache_read_tokens",
+                 "session_cache_write_tokens", "session_reasoning_tokens"):
+        setattr(agent, name, 0)
+    agent.session_estimated_cost_usd = 0.0
+    agent._interrupt_requested = False
+    return agent
+
+
+def test_run_turn_persists_and_reports_agent_persisted():
+    turn = SimpleNamespace(final_text="done", projected_messages=[{"role": "assistant", "content": "done"}],
+                           tool_iterations=2, interrupted=False, error=None, session_id="sid", submitted_user_text="hi",
+                           usage={"input_tokens": 4, "output_tokens": 2, "cache_read_input_tokens": 0,
+                                  "cache_creation_input_tokens": 1}, total_cost_usd=0.02, should_retire=False)
+    agent = _agent(turn)
+    result = run_claude_code_turn(agent, user_message="hi", original_user_message="hi",
+                                  messages=[{"role": "user", "content": "hi"}], effective_task_id="t1")
+    assert result["completed"] is True and result["agent_persisted"] is True
+    assert result["final_response"] == "done" and result["claude_session_id"] == "sid"
+    assert result["messages"][-1]["content"] == "done"
+    assert agent._iters_since_skill == 2
+    assert agent.session_api_calls == 1 and agent.session_input_tokens == 4
+    assert agent.session_estimated_cost_usd == 0.02
+
+
+def test_retired_turn_closes_the_session_and_surfaces_the_error():
+    turn = SimpleNamespace(final_text="", projected_messages=[], tool_iterations=0, interrupted=False,
+                           error="claude code exited during the turn", session_id="sid", submitted_user_text="hi",
+                           usage=None, total_cost_usd=None, should_retire=True)
+    agent = _agent(turn)
+    result = run_claude_code_turn(agent, user_message="hi", original_user_message="hi",
+                                  messages=[{"role": "user", "content": "hi"}], effective_task_id="t1")
+    assert result["completed"] is False
+    assert "Claude Code turn failed" in result["final_response"]
+    assert agent._claude_session is None
+
+
+def test_event_bridge_fires_tool_progress_pairs():
+    agent = MagicMock()
+    agent.show_commentary = True
+    calls = []
+    agent.tool_progress_callback = lambda *a, **k: calls.append(("progress", a[0], a[1], k.get("is_error")))
+    agent.tool_start_callback = lambda *a: calls.append(("start", a[1]))
+    agent.tool_complete_callback = lambda *a: calls.append(("complete", a[1], a[3]))
+    agent._emit_interim_assistant_message = lambda m: calls.append(("interim", m["content"]))
+    bridge = make_claude_code_event_bridge(agent)
+    bridge({"type": "assistant", "message": {"content": [
+        {"type": "text", "text": "Checking."}, {"type": "tool_use", "id": "t1", "name": "Bash", "input": {"command": "ls"}}]}})
+    bridge({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "t1", "content": "ok", "is_error": False}]}})
+    bridge({"type": "assistant", "message": {"content": [{"type": "text", "text": "Final answer."}]}})
+    assert calls == [("interim", "Checking."), ("progress", "tool.started", "Bash", None), ("start", "Bash"),
+                     ("progress", "tool.completed", "Bash", False), ("complete", "Bash", "ok")]
+
+
+def test_usage_without_block_still_counts_the_call():
+    agent = _agent(SimpleNamespace())
+    result = _record_claude_code_usage(agent, SimpleNamespace(usage=None, total_cost_usd=None))
+    assert result == {} and agent.session_api_calls == 1
+
+
+def test_runtime_rewrite_applies_from_config_for_any_provider():
+    from hermes_cli.runtime_provider import _maybe_apply_claude_code_runtime
+    assert _maybe_apply_claude_code_runtime(provider="custom", api_mode="chat_completions",
+                                            model_cfg={"anthropic_runtime": "claude_code"}) == "claude_code"
+    assert _maybe_apply_claude_code_runtime(provider="anthropic", api_mode="anthropic_messages",
+                                            model_cfg={"anthropic_runtime": "auto"}) == "anthropic_messages"
+    assert _maybe_apply_claude_code_runtime(provider="anthropic", api_mode="anthropic_messages", model_cfg=None) == "anthropic_messages"
